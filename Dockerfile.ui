FROM python:3.12-slim
WORKDIR /ui
RUN pip install --no-cache-dir "streamlit>=1.40" requests
ENV STREAMLIT_SERVER_HEADLESS=true \
    STREAMLIT_BROWSER_GATHER_USAGE_STATS=false
EXPOSE 8501
# fileWatcherType=poll: bind mounts from Windows do not send file-change events
CMD ["streamlit", "run", "streamlit_app.py", "--server.port=8501", "--server.address=0.0.0.0", "--server.fileWatcherType=poll"]